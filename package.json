{
  "name": "mirror-link",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:plugin && npm run build:ui",
    "build:plugin": "node esbuild.config.mjs",
    "build:ui": "vite build",
    "watch": "concurrently \"npm run watch:plugin\" \"npm run watch:ui\"",
    "watch:plugin": "node esbuild.config.mjs --watch",
    "watch:ui": "vite build --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.124.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.21.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^4.1.4"
  }
}
